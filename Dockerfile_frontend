# Use official lightweight Python image
FROM python:3.10-slim

# Set working directory inside container
WORKDIR /app

# Copy frontend requirements file to target directory
COPY requirements_frontend.txt /app/requirements.txt

# Install frontend dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy Streamlit application and model artifact into container
COPY streamlit_app.py /app/streamlit_app.py
COPY model.pkl /app/model.pkl

# Expose port 8501 for Streamlit access
EXPOSE 8501

# Run Streamlit frontend server
CMD ["streamlit", "run", "streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
